# generated/build_version.h: which source a binary was built from (issue #75).
#
# This runs on every build instead of being wired to a file dependency, because there is no file
# the build could watch: a commit rewrites .git/refs/heads/<branch> (or packed-refs), not
# .git/HEAD, and neither changes mtime in a way a generator can key off. The header is written
# through a temp file and only replaces the old one when the text differs, so an unchanged tree
# costs one no-op compare per build and nothing downstream recompiles.
#
# Output goes in the build directory, never the source tree: the identity belongs to the binary.
# Not a git checkout (source tarball) or no git binary leaves the strings as "unknown"; the build
# still succeeds, and a run then says so instead of guessing.

if(NOT GIT_EXECUTABLE)
    find_package(Git QUIET)
endif()

set(rev "unknown")
set(branch "unknown")
set(suffix "")
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short HEAD
                    OUTPUT_VARIABLE r OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(rc EQUAL 0 AND NOT r STREQUAL "")
        set(rev "${r}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --abbrev-ref HEAD
                        OUTPUT_VARIABLE b OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(rc EQUAL 0 AND NOT b STREQUAL "")
            set(branch "${b}")
        endif()
        # -dirty means the binary does not match that commit: uncommitted edits, or files left
        # over from another branch's build. Both are exactly what a report would get wrong.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain
                        OUTPUT_VARIABLE s ERROR_QUIET)
        string(STRIP "${s}" s)
        if(NOT s STREQUAL "")
            set(suffix "-dirty")
        endif()
    endif()
else()
    message(STATUS "git not found: build identity will say 'unknown'")
endif()

string(TIMESTAMP today "%Y-%m-%d" UTC)

# A CI checkout is detached at the commit under test, so git has no branch to name; the Actions
# variables say what it was asking for. Plain "detached" beats an uninformative "HEAD".
if(branch STREQUAL "HEAD")
    if(NOT "$ENV{GITHUB_HEAD_REF}" STREQUAL "")
        set(branch "$ENV{GITHUB_HEAD_REF}")
    elseif(NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "")
        set(branch "$ENV{GITHUB_REF_NAME}")
    else()
        set(branch "detached")
    endif()
endif()

file(WRITE "${OUT}.tmp"
     "// Generated by cmake/git_version.cmake at build time. Do not edit, do not commit.\n"
     "// Which source this binary came from; runtime/build_id.h turns it into the four strings\n"
     "// the log, the window title, capture summaries and --version print.\n"
     "// BB_GIT_SUFFIX is empty when the tree was clean at build time.\n"
     "#pragma once\n"
     "#define BB_GIT_REV    \"${rev}\"\n"
     "#define BB_GIT_BRANCH \"${branch}\"\n"
     "#define BB_GIT_SUFFIX \"${suffix}\"\n"
     "#define BB_BUILD_DATE \"${today}\"\n")

# Replace only on change, so the date alone does not force a rebuild of everything that includes it.
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${OUT}.tmp")
